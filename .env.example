PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_OUTBOX_QUEUE_NAME=wagering-events
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500

CONSUMER_ENABLED=true
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_RETRY_BASE_SECONDS=2
CONSUMER_WAIT_TIME_SECONDS=10

PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_MAX_ATTEMPTS=10
