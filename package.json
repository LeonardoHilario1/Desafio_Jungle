{
  "name": "wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/principal.ts",
    "migration:up": "bun src/migrar.ts up",
    "migration:down": "bun src/migrar.ts down",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/integration/concurrency.test.ts --rerun-each=20"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.6",
    "@nestjs/testing": "12.3.2",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1161.0",
    "@mikro-orm/core": "7.2.6",
    "@mikro-orm/migrations": "7.2.6",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.6",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
